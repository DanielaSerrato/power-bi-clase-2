table Escenarios

	column escenario_id
		dataType: string
		summarizeBy: none
		sourceColumn: escenario_id

	column escenario
		dataType: string
		summarizeBy: none
		sourceColumn: escenario

	column ciudad
		dataType: string
		summarizeBy: none
		sourceColumn: ciudad

	column capacidad
		dataType: int64
		summarizeBy: none
		sourceColumn: capacidad

	partition Escenarios = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v3/datos/02_musica/dim_escenarios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"escenario_id", type text}, {"escenario", type text}, {"ciudad", type text}, {"capacidad", Int64.Type}}, "es-CO")
				in
				    Types

