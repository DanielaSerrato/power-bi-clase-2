table Generos

	column genero_id
		dataType: string
		summarizeBy: none
		sourceColumn: genero_id

	column genero
		dataType: string
		summarizeBy: none
		sourceColumn: genero

	partition Generos = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v2/datos/02_musica/dim_generos.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"genero_id", type text}, {"genero", type text}}, "es-CO")
				in
				    Types

