table Eventos

	column evento_id
		dataType: string
		summarizeBy: none
		sourceColumn: evento_id

	column fecha
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha

	column escenario_id
		dataType: string
		summarizeBy: none
		sourceColumn: escenario_id

	column genero_id
		dataType: string
		summarizeBy: none
		sourceColumn: genero_id

	column asistentes
		dataType: int64
		summarizeBy: none
		sourceColumn: asistentes

	column boleteria_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: boleteria_cop

	column costo_evento_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: costo_evento_cop

	partition Eventos = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v3/datos/02_musica/fact_eventos.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"evento_id", type text}, {"fecha", type date}, {"escenario_id", type text}, {"genero_id", type text}, {"asistentes", Int64.Type}, {"boleteria_cop", Int64.Type}, {"costo_evento_cop", Int64.Type}}, "es-CO")
				in
				    Types

