table Ventas

	column venta_id
		dataType: string
		summarizeBy: none
		sourceColumn: venta_id

	column fecha
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha

	column tienda_id
		dataType: string
		summarizeBy: none
		sourceColumn: tienda_id

	column producto_id
		dataType: string
		summarizeBy: none
		sourceColumn: producto_id

	column canal
		dataType: string
		summarizeBy: none
		sourceColumn: canal

	column unidades
		dataType: int64
		summarizeBy: none
		sourceColumn: unidades

	column venta_bruta_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: venta_bruta_cop

	column descuento_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: descuento_cop

	column venta_neta_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: venta_neta_cop

	column costo_total_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: costo_total_cop

	partition Ventas = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v1/datos/01_ropa/fact_ventas.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"venta_id", type text}, {"fecha", type date}, {"tienda_id", type text}, {"producto_id", type text}, {"canal", type text}, {"unidades", Int64.Type}, {"venta_bruta_cop", Int64.Type}, {"descuento_cop", Int64.Type}, {"venta_neta_cop", Int64.Type}, {"costo_total_cop", Int64.Type}}, "es-CO")
				in
				    Types

