table Productos

	column producto_id
		dataType: string
		summarizeBy: none
		sourceColumn: producto_id

	column producto
		dataType: string
		summarizeBy: none
		sourceColumn: producto

	column categoria
		dataType: string
		summarizeBy: none
		sourceColumn: categoria

	column coleccion
		dataType: string
		summarizeBy: none
		sourceColumn: coleccion

	column precio_lista_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: precio_lista_cop

	column costo_unitario_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: costo_unitario_cop

	partition Productos = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v3/datos/01_ropa/dim_productos.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"producto_id", type text}, {"producto", type text}, {"categoria", type text}, {"coleccion", type text}, {"precio_lista_cop", Int64.Type}, {"costo_unitario_cop", Int64.Type}}, "es-CO")
				in
				    Types

