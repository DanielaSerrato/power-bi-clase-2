table Oficinas

	column oficina_id
		dataType: string
		summarizeBy: none
		sourceColumn: oficina_id

	column oficina
		dataType: string
		summarizeBy: none
		sourceColumn: oficina

	column ciudad
		dataType: string
		summarizeBy: none
		sourceColumn: ciudad

	partition Oficinas = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v1/datos/04_atencion/dim_oficinas.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"oficina_id", type text}, {"oficina", type text}, {"ciudad", type text}}, "es-CO")
				in
				    Types

