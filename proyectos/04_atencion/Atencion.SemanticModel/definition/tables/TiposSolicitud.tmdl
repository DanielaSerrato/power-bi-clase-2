table TiposSolicitud

	column tipo_id
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_id

	column tipo_solicitud
		dataType: string
		summarizeBy: none
		sourceColumn: tipo_solicitud

	column sla_dias
		dataType: int64
		summarizeBy: none
		sourceColumn: sla_dias

	partition TiposSolicitud = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v3/datos/04_atencion/dim_tipos_solicitud.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"tipo_id", type text}, {"tipo_solicitud", type text}, {"sla_dias", Int64.Type}}, "es-CO")
				in
				    Types

