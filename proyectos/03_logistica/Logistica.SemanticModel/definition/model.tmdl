model Model
	culture: es-CO
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-CO
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Calendario", "Zonas", "Servicios", "Entregas"]

ref table Calendario
ref table Zonas
ref table Servicios
ref table Entregas

