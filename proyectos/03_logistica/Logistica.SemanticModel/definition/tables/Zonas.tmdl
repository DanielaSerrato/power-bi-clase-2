table Zonas

	column zona_id
		dataType: string
		summarizeBy: none
		sourceColumn: zona_id

	column zona
		dataType: string
		summarizeBy: none
		sourceColumn: zona

	column ciudad
		dataType: string
		summarizeBy: none
		sourceColumn: ciudad

	partition Zonas = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v2/datos/03_logistica/dim_zonas.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"zona_id", type text}, {"zona", type text}, {"ciudad", type text}}, "es-CO")
				in
				    Types

