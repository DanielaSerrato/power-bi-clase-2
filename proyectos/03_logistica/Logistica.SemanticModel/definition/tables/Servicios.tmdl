table Servicios

	column servicio_id
		dataType: string
		summarizeBy: none
		sourceColumn: servicio_id

	column servicio
		dataType: string
		summarizeBy: none
		sourceColumn: servicio

	column promesa_horas
		dataType: int64
		summarizeBy: none
		sourceColumn: promesa_horas

	partition Servicios = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v3/datos/03_logistica/dim_servicios.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"servicio_id", type text}, {"servicio", type text}, {"promesa_horas", Int64.Type}}, "es-CO")
				in
				    Types

