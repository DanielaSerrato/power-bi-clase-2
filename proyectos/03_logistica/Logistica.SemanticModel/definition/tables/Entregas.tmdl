table Entregas

	column entrega_id
		dataType: string
		summarizeBy: none
		sourceColumn: entrega_id

	column fecha_despacho
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_despacho

	column zona_id
		dataType: string
		summarizeBy: none
		sourceColumn: zona_id

	column servicio_id
		dataType: string
		summarizeBy: none
		sourceColumn: servicio_id

	column horas_reales
		dataType: int64
		summarizeBy: none
		sourceColumn: horas_reales

	column a_tiempo
		dataType: int64
		summarizeBy: none
		sourceColumn: a_tiempo

	column costo_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: costo_cop

	partition Entregas = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v1/datos/03_logistica/fact_entregas.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"entrega_id", type text}, {"fecha_despacho", type date}, {"zona_id", type text}, {"servicio_id", type text}, {"horas_reales", Int64.Type}, {"a_tiempo", Int64.Type}, {"costo_cop", Int64.Type}}, "es-CO")
				in
				    Types

