table Movimientos

	column movimiento_id
		dataType: string
		summarizeBy: none
		sourceColumn: movimiento_id

	column cliente_id
		dataType: string
		summarizeBy: none
		sourceColumn: cliente_id

	column plan_id
		dataType: string
		summarizeBy: none
		sourceColumn: plan_id

	column region_id
		dataType: string
		summarizeBy: none
		sourceColumn: region_id

	column periodo
		dataType: string
		summarizeBy: none
		sourceColumn: periodo

	column fecha_operacion
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_operacion

	column canal
		dataType: string
		summarizeBy: none
		sourceColumn: canal

	column importe_bruto_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: importe_bruto_cop

	column descuento_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: descuento_cop

	column importe_neto_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: importe_neto_cop

	column clave_periodo_plan_region
		dataType: string
		summarizeBy: none
		sourceColumn: clave_periodo_plan_region

	partition Movimientos = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v1/datos/00_marea/movimientos_facturacion.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"movimiento_id", type text}, {"cliente_id", type text}, {"plan_id", type text}, {"region_id", type text}, {"periodo", type text}, {"fecha_operacion", type date}, {"canal", type text}, {"importe_bruto_cop", Int64.Type}, {"descuento_cop", Int64.Type}, {"importe_neto_cop", Int64.Type}}, "es-CO"),
				    Key = Table.AddColumn(Types, "clave_periodo_plan_region", each [periodo] & "|" & [plan_id] & "|" & [region_id], type text)
				in
				    Key

