table NotasCredito

	column nota_id
		dataType: string
		summarizeBy: none
		sourceColumn: nota_id

	column movimiento_id
		dataType: string
		summarizeBy: none
		sourceColumn: movimiento_id

	column periodo
		dataType: string
		summarizeBy: none
		sourceColumn: periodo

	column plan_id
		dataType: string
		summarizeBy: none
		sourceColumn: plan_id

	column region_id
		dataType: string
		summarizeBy: none
		sourceColumn: region_id

	column fecha_nota
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_nota

	column monto_credito_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: monto_credito_cop

	partition NotasCredito = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v3/datos/00_marea/notas_credito.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"nota_id", type text}, {"movimiento_id", type text}, {"periodo", type text}, {"plan_id", type text}, {"region_id", type text}, {"fecha_nota", type date}, {"monto_credito_cop", Int64.Type}}, "es-CO")
				in
				    Types

