table Planes

	column plan_id
		dataType: string
		summarizeBy: none
		sourceColumn: plan_id

	column plan
		dataType: string
		summarizeBy: none
		sourceColumn: plan

	column segmento
		dataType: string
		summarizeBy: none
		sourceColumn: segmento

	column precio_lista_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: precio_lista_cop

	partition Planes = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v2/datos/00_marea/planes.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"plan_id", type text}, {"plan", type text}, {"segmento", type text}, {"precio_lista_cop", Int64.Type}}, "es-CO")
				in
				    Types

