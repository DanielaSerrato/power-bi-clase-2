table Clientes

	column cliente_id
		dataType: string
		summarizeBy: none
		sourceColumn: cliente_id

	column region_id
		dataType: string
		summarizeBy: none
		sourceColumn: region_id

	column fecha_alta
		dataType: dateTime
		summarizeBy: none
		sourceColumn: fecha_alta

	partition Clientes = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v1/datos/00_marea/clientes.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"cliente_id", type text}, {"region_id", type text}, {"fecha_alta", type date}}, "es-CO")
				in
				    Types

