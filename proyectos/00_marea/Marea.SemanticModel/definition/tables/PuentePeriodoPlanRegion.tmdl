table PuentePeriodoPlanRegion

	column clave_periodo_plan_region
		dataType: string
		summarizeBy: none
		sourceColumn: clave_periodo_plan_region

	column periodo
		dataType: string
		summarizeBy: none
		sourceColumn: periodo

	column anio
		dataType: int64
		summarizeBy: none
		sourceColumn: anio

	column mes
		dataType: int64
		summarizeBy: none
		sourceColumn: mes

	column plan_id
		dataType: string
		summarizeBy: none
		sourceColumn: plan_id

	column plan
		dataType: string
		summarizeBy: none
		sourceColumn: plan

	column segmento
		dataType: string
		summarizeBy: none
		sourceColumn: segmento

	column precio_lista_cop
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: precio_lista_cop

	column region_id
		dataType: string
		summarizeBy: none
		sourceColumn: region_id

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	partition PuentePeriodoPlanRegion = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/DanielaSerrato/power-bi-clase-2/clase2-v1/datos/00_marea/puente_periodo_plan_region.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {{"periodo", type text}, {"anio", Int64.Type}, {"mes", Int64.Type}, {"plan_id", type text}, {"plan", type text}, {"segmento", type text}, {"precio_lista_cop", Int64.Type}, {"region_id", type text}, {"region", type text}}, "es-CO"),
				    Key = Table.AddColumn(Types, "clave_periodo_plan_region", each [periodo] & "|" & [plan_id] & "|" & [region_id], type text)
				in
				    Key

